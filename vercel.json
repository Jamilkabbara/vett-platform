{
  "redirects": [
    {
      "source": "/vs/traditional-research",
      "destination": "/vs/traditional",
      "statusCode": 301
    },
    {
      "source": "/vs/traditional-research/",
      "destination": "/vs/traditional",
      "statusCode": 301
    },
    {
      "source": "/vs/pollfish",
      "destination": "/vs",
      "statusCode": 301
    },
    {
      "source": "/vs/pollfish/",
      "destination": "/vs",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|svg|png|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
